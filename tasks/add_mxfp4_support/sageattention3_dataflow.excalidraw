      "type": "text",
      "x": 180,
      "y": 236,
      "width": 640,
      "height": 22,
      "text": "② q̄ᵢ = mean(Qᵢ), Qᵢ = Qᵢ − q̄ᵢ   (per Bq-block, corrected by GEMV)",
      "fontSize": 16,
      "fontFamily": 3,
